# Copy to `.env.local` and fill in. Restart `next dev` after edits.

# Medium — handle without the leading "@"
MEDIUM_USERNAME=

# GitHub
GITHUB_USERNAME=
NEXT_PUBLIC_GITHUB_USERNAME=

# LeetCode
LEETCODE_USERNAME=
NEXT_PUBLIC_LEETCODE_USERNAME=

# YouTube — provide either the channel id ("UC..." preferred) OR the handle.
# If only the handle is set, the API resolves the channel id automatically.
YOUTUBE_CHANNEL_ID=
YOUTUBE_HANDLE=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
